{
  "name": "nebula-deception",
  "version": "0.1.0",
  "private": true,
  "description": "A private browser-based social-deduction game with peer-to-peer multiplayer.",
  "engines": {
    "node": ">=20.9.0 <26"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:logic && npm run test:security",
    "test:logic": "tsx scripts/run-e2e-tests.ts",
    "test:security": "tsx scripts/test-host-security.ts",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "autoprefixer": "10.5.4",
    "lucide-react": "1.32.0",
    "next": "16.3.1",
    "peerjs": "1.5.5",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
